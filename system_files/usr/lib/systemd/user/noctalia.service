[Unit]
Description=Noctalia (bar, notifications, launcher, lock screen, OSD, polkit agent)
Documentation=https://docs.noctalia.dev/noctalia/
# This one unit is the whole shell. If it is not running there is no bar, no
# notifications, no launcher, no OSD, no lock screen and no polkit prompt -- so
# pkexec, ujust and bazzite-user-setup block forever. That is why verify.sh
# checks `is-active` on this unit first.
PartOf=graphical-session.target
After=graphical-session.target
# Nothing here can start without a compositor to bind layer surfaces to.
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
# The BARE binary, deliberately not `noctalia --daemon`. --daemon returns once
# the shell is up, which under systemd is wrong twice over: the supervised
# process would exit immediately so Restart=on-failure would watch a corpse, and
# the real shell would run outside the unit's cgroup.
Type=simple
ExecStart=/usr/bin/noctalia
Restart=on-failure
RestartSec=1
Slice=session.slice
TimeoutStopSec=5

[Install]
WantedBy=sway-session.target
