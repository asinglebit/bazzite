[Unit]
Description=Noctalia (bar, notifications, launcher, lock screen, OSD, polkit agent)
Documentation=https://docs.noctalia.dev/noctalia/
# This one unit is the whole shell, and without it pkexec and ujust block forever.
PartOf=graphical-session.target
After=graphical-session.target
# Nothing here can start without a compositor to bind layer surfaces to.
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
# The bare binary, because --daemon returns early and leaves the real shell outside the cgroup.
Type=simple
ExecStart=/usr/bin/noctalia
Restart=on-failure
RestartSec=1
Slice=session.slice
TimeoutStopSec=5

[Install]
WantedBy=sway-session.target
