[Unit]
Description=PolicyKit authentication agent (MATE)
Documentation=man:polkit(8)
# Without an agent, pkexec / ujust / bazzite-user-setup block forever waiting
# for an authentication dialog that never appears.
PartOf=graphical-session.target
After=graphical-session.target
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
Type=simple
ExecStart=/usr/libexec/polkit-mate-authentication-agent-1
Restart=on-failure
RestartSec=1
Slice=session.slice
TimeoutStopSec=5

[Install]
WantedBy=sway-session.target
