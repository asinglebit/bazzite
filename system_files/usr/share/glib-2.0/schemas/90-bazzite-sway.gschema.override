# The values GTK actually uses: on Wayland it ignores settings.ini and asks the portal.
# In the image, because the desktop must come up correct before any dotfiles repo is cloned.
# Only a default, so a key written into dconf still wins until `dconf reset`.

[org.gnome.desktop.interface]
gtk-theme='adw-gtk3-dark'
icon-theme='Papirus-Dark'
cursor-theme='Adwaita'
color-scheme='prefer-dark'

# The mono face is only for the terminal now, since noctalia ships its own icon font.
font-name='Inter 10'
document-font-name='Inter 10'
monospace-font-name='Hack Nerd Font Mono 10'
