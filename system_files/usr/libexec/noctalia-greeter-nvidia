#!/usr/bin/sh
# The greeter's compositor is its own wlroots instance and inherits none of /etc/sway/environment.
# A wrapper rather than a drop-in, because greetd builds the session environment itself.
# `:=` leaves an inherited value alone, so `just greeter-preview` can run this same file nested.

# gles2 is the only renderer proven on nvidia-open, and the fallback displays nothing at all.
: "${WLR_RENDERER:=gles2}"
export WLR_RENDERER

# Deliberately unset: --unsupported-gpu and -D noscanout are sway guards this compositor lacks.
# WLR_BACKENDS is left to autodetect, so this works on VT 1 and nested alike.
# For black frames or tearing here, the wlroots equivalent is WLR_DRM_NO_MODIFIERS=1.

exec /usr/bin/noctalia-greeter-session "$@"
