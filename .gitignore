# The cosign private key, which lives only in the SIGNING_SECRET Actions secret.
cosign.key
*.key
*.pem

# cosign.pub is deliberately NOT ignored: it is public and the image bakes it in.

# Local build droppings
*.bak-*

# Obsidian per-machine UI state; the rest of docs/.obsidian is shared.
docs/.obsidian/workspace.json
docs/.obsidian/cache
