/*
 * Greyscale rofi -- the $mod+d launcher, painted from waybar's palette.
 *
 * /etc/sway/config builds the launcher as `rofi -terminal ghostty -show combi
 * -combi-modes drun#run -modes combi` and passes no -theme, so rofi picks this
 * file up on its own: config.rasi is what it loads by default. Everything here
 * layers over rofi's built-in theme, which is Solarized *light* -- the reason a
 * stock $mod+d flashes a cream panel onto an otherwise black desktop.
 *
 * Deliberately one file rather than the usual `configuration {}` + @theme pair.
 * link-dotfiles symlinks individual files, so ~/.config/rofi/config.rasi is a
 * link into this repo, and rofi resolves a relative @theme path against the
 * file it is reading -- which would send it looking in the repo rather than in
 * ~/.config. One file has no such path to get wrong.
 *
 * Palette, dark to light. Identical to dotfiles/waybar/style.css:
 *
 *   #1a1a1a  window background  -- the same surface as the bar, and like the
 *            bar it is drawn at alpha so SwayFX can blur behind it
 *   #2e2e2e  hairline, and the selected row's fill
 *   #5a5a5a  dim    - placeholder, match counters, scrollbar handle
 *   #9a9a9a  base   - unselected entries
 *   #d8d8d8  bright - selection, typed text, prompt
 *   #ffffff  alert  - urgent
 *
 * The bar signals with brightness rather than hue, and so does this: the only
 * filled block anywhere is the selected row, and its #2e2e2e is the same grey
 * waybar uses for a workspace hover.
 */

* {
    /* rofi's default theme derives every slot below from four roots
     * (background/foreground/lightbg/lightfg plus red and blue) via var().
     * Each slot is restated explicitly anyway, the same way 20-appearance.conf
     * spells out every client.* row: nothing then depends on how a given rofi
     * release happens to resolve an inherited reference. */
    background:                  #1a1a1a;
    foreground:                  #9a9a9a;

    background-color:            transparent;
    border-color:                #2e2e2e;
    separatorcolor:              #2e2e2e;

    /* Unselected rows sit directly on the window background -- no zebra
     * striping, which is what stock does with `alternate` and what puts a
     * second background colour on screen. */
    normal-background:           transparent;
    normal-foreground:           #9a9a9a;
    alternate-normal-background: transparent;
    alternate-normal-foreground: #9a9a9a;
    selected-normal-background:  #2e2e2e;
    selected-normal-foreground:  #d8d8d8;

    /* "active" in drun marks an application that is already running. Brighter
     * than a normal row but with no fill, so the fill stays unambiguously the
     * selection -- the same split waybar makes between a focused workspace
     * (#d8d8d8 text) and a hovered one (#262626 fill). */
    active-background:           transparent;
    active-foreground:           #d8d8d8;
    alternate-active-background: transparent;
    alternate-active-foreground: #d8d8d8;
    selected-active-background:  #2e2e2e;
    selected-active-foreground:  #ffffff;

    urgent-background:           transparent;
    urgent-foreground:           #ffffff;
    alternate-urgent-background: transparent;
    alternate-urgent-foreground: #ffffff;
    selected-urgent-background:  #2e2e2e;
    selected-urgent-foreground:  #ffffff;

    /* Unreferenced now that every slot above is set directly, but these are
     * the roots a future rofi would derive any *newly added* element from.
     * Neutralised rather than left as Solarized cream and blue, so a new
     * widget inherits into this palette instead of out of it. */
    lightbg:                     #2e2e2e;
    lightfg:                     #9a9a9a;
    red:                         #ffffff;
    blue:                        #d8d8d8;

    /* Matches waybar's `font-size: 11px` exactly. The "px" suffix is what
     * makes it an absolute size: a bare number in a Pango font description is
     * points, so plain "11" would render about a third larger than the bar. */
    font:                        "Hack Nerd Font Mono, monospace 11px";
}

window {
    /* Alpha, so `layer_effects "rofi" blur enable` in
     * sway/config.d/25-effects.conf has something to show through. Blur
     * applies to what is BEHIND a surface, so an opaque background would have
     * the compositor compute it and then hide it.
     *
     * 0xbb is a touch more opaque than the bar's 0.72: the launcher is a
     * dense list of small text over whatever happens to be on the desktop,
     * where the bar is a single row over mostly wallpaper. */
    background-color: #1a1a1abb;
    border:           1px;
    border-color:     #2e2e2e;
}

/* Separators. Stock draws these as a 2px *dashed* rule; the bar's divider is a
 * 1px solid hairline (`border-bottom: 1px solid #2e2e2e`), so match it. */
listview {
    border:       1px solid 0px 0px;
    border-color: #2e2e2e;
}

message {
    border:       1px solid 0px 0px;
    border-color: #2e2e2e;
}

sidebar {
    border:       1px solid 0px 0px;
    border-color: #2e2e2e;
}

scrollbar {
    handle-color: #5a5a5a;
}

inputbar {
    text-color: #9a9a9a;
}

prompt {
    text-color: #d8d8d8;
}

textbox-prompt-colon {
    text-color: #5a5a5a;
}

entry {
    text-color:        #d8d8d8;
    placeholder-color: #5a5a5a;
}

textbox {
    text-color: #9a9a9a;
}

/* The "n/m" match counters and the case-sensitivity flag. Stock hardcodes the
 * literal colour `Gray` for these rather than deriving them, so they are the
 * one group that stays off-palette unless named individually. */
num-filtered-rows,
num-rows,
textbox-num-sep,
case-indicator {
    text-color: #5a5a5a;
}

/* The mode-switcher tabs, shown when more than one mode is loaded. */
button {
    text-color: #9a9a9a;
}

button selected {
    background-color: #2e2e2e;
    text-color:       #d8d8d8;
}

overlay {
    background-color: #2e2e2e;
    text-color:       #d8d8d8;
}
