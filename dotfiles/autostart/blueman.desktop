[Desktop Entry]
Type=Application
Name=Blueman Applet
Exec=blueman-applet
# Overrides the /etc/xdg copy by basename, and Hidden=true stops systemd autostarting it.
# Its tray icon is an unthemeable colour PNG, and the bar already draws bluetooth.
# The cost is no prompt for incoming pairing requests, though blueman-manager still works.
Hidden=true
