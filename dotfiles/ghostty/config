# Terminal chrome, matching the greyscale desktop.
#
# Only the chrome is themed here: background, foreground, cursor, selection.
# The 16 ANSI colours are left at ghostty's defaults on purpose -- syntax
# highlighting, ls, diff and every TUI depend on them, and the greyscale
# treatment is for the desktop furniture, not for program output.
#
# Palette, dark to light (shared with waybar/style.css):
#   #1a1a1a  background   (desktop is #242424, so windows read darker,
#                          the same relationship the bar already has)
#   #2e2e2e  selection
#   #5a5a5a  dim
#   #9a9a9a  base
#   #d8d8d8  bright - foreground
#
# ghostty takes hex with or without the leading '#'.
#
# Validate after editing, without launching a window:
#
#     ghostty +validate-config
#

background = 1a1a1a
foreground = d8d8d8

cursor-style = block
selection-background = 2e2e2e
selection-foreground = d8d8d8

# Noto Sans Mono is what waybar uses. nerd-fonts 3.5.1 is installed and ghostty
# also carries Nerd Font symbols as a built-in fallback, so glyph coverage holds
# either way. Delete this line to get ghostty's bundled JetBrains Mono instead.
#
# font-size is in points, not pixels, so it is not directly comparable to
# waybar's 11px -- and the Dell runs at scale 2. This is the one value here
# worth tuning by eye; it is a dotfile, so that is a relaunch, not a rebuild.
font-family = Noto Sans Mono
font-size = 11

# ghostty's GTK4 frontend draws its own headerbar by default, which would put a
# titlebar back inside every window immediately after 20-appearance.conf took
# sway's away. This is an enum (none/auto/client/server), not a boolean.
window-decoration = none

# sway hands each window an arbitrary pixel size, but ghostty's grid is whole
# character cells -- the leftover that will not fill a cell has to go
# somewhere. At zero padding that remainder is the only padding left, and
# balance splits it across opposite edges rather than piling all of it on the
# right and bottom.
window-padding-x = 0
window-padding-y = 0
window-padding-balance = true
