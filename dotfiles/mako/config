# Greyscale mako -- the FALLBACK notification daemon.
#
# swaync is what actually runs (build_files/10-sway-install.sh ships the
# sway-session.target.wants symlink, so it claims
# org.freedesktop.Notifications at session start). mako stays installed and
# unbound for the same reason foot, tuigreet, swaylock and swayidle do: if
# swaync breaks, notifications should degrade rather than disappear.
#
# This file exists so that the degraded path is not ALSO the stock blue box
# this whole change set exists to remove. mako had no config anywhere on this
# system -- not here, not /etc/xdg/mako/config -- so it ran on compiled
# defaults: #285577FF background, #4C7899FF border, #FFFFFFFF text, and
# default-timeout=0, i.e. notifications that never went away.
#
# To use it: `systemctl --user stop swaync && systemctl --user start mako`.
# Both cannot run at once -- whichever takes org.freedesktop.Notifications
# first keeps it, and the second exits.
#
# mako replaces its config wholesale (first file found wins: this one, then
# /etc/xdg/mako/config), so it has to be complete rather than a set of
# overrides.
#
# Validate after editing, without restarting anything:
#     makoctl reload    # only if mako is the daemon currently running
#
# Palette matches waybar/style.css and swaync/style.css:
#   1a1a1a  background   9a9a9a  text
#   2e2e2e  border       d8d8d8  bright
#   ffffff  alert -- greyscale has no red, so urgency signals with brightness

font=Hack Nerd Font Mono 10

background-color=#1a1a1a
text-color=#9a9a9a
border-color=#2e2e2e

border-size=1
border-radius=8
padding=10
margin=6

# Under the 22px bar, on the right, matching where swaync puts its popups so
# the fallback appears in the same place.
anchor=top-right
width=420
height=140
layer=overlay
default-timeout=10000

# The summary carries the weight, the body is quieter -- the same split
# swaync's --text-color / .summary rules make.
format=<b>%s</b>\n%b
markup=1

[urgency=low]
text-color=#5a5a5a
default-timeout=5000

[urgency=normal]
text-color=#9a9a9a

# Sticky and bright, the one class allowed to shout.
[urgency=critical]
text-color=#ffffff
border-color=#ffffff
default-timeout=0
